-- programs

entrypoints Program ; -- start symbol

Prog.       Program ::= [TopDef] ;

FnDef.      TopDef ::= DType Ident "(" [Arg] ")" Block ;

separator   nonempty TopDef "" ;

Ar.         Arg ::= DType Ident ;

separator   Arg "," ;

-- top-level class definitions (structs + objects)

ClassDef.   TopDef ::= "class" Ident "{" [Member] "}" ;

ClassExt.   TopDef ::= "class" Ident "extends" Ident "{" [Member] "}" ;

separator   Member "" ;

-- members inside class

Field.  Member ::= DType Ident ";" ;

Method. Member ::= DType Ident "(" [Arg] ")" Block ;

-- statements

Blk.        Block ::= "{" [Stmt] "}" ;

separator   Stmt "" ;

Empty.      Stmt ::= ";" ;

BStmt.      Stmt ::= Block ;

Decl.  Stmt   ::= DType [Item] ";" ;

NoInit.     Item ::= Ident ;

Init.       Item ::= Ident "=" Expr ;

separator   nonempty Item "," ;

Ass.        Stmt ::= Expr6 "=" Expr ";" ;

Incr.       Stmt ::= Expr6 "++" ";" ;

Decr.       Stmt ::= Expr6 "--" ";" ;

Ret.        Stmt ::= "return" Expr ";" ;

VRet.       Stmt ::= "return" ";" ;

Cond.       Stmt ::= "if" "(" Expr ")" Stmt ;

CondElse.   Stmt ::= "if" "(" Expr ")" Stmt "else" Stmt ;

While.      Stmt ::= "while" "(" Expr ")" Stmt ;

SExp.       Stmt ::= Expr ";" ;

ForEach.    Stmt ::= "for" "(" BaseType Ident ":" Expr ")" Stmt ;

-- Types

DVoid.          DType ::= "void" ;

DTypeBase.      DType ::= BaseType ;

DTypeArr.       DType ::= BaseType "[" "]" ;

TBase.          Type ::= BaseType ;

TArr.           Type ::= BaseType "[" "]" ; -- 1D arrays

Int.            BaseType ::= "int" ;

Str.            BaseType ::= "string" ;

Bool.           BaseType ::= "boolean" ;

ClassT.         BaseType ::= Ident ;

Void.           Type ::= "void" ;

internal Fun.   Type ::= Type "(" [Type] ")" ;

separator       Type "," ;

-- Expressions

EParen.         Expr7 ::= "(" Expr ")" ;

ESelf.          Expr7 ::= "self" ;

ENull.          Expr7 ::= "null" ;

ENullCast.      Expr7 ::= "(" Type ")" "null" ;

ENewArr.        Expr7 ::= "new" BaseType "[" Expr "]" ;

ENewObj.        Expr7 ::= "new" Ident ;

EVar.           Expr7 ::= Ident ;

ELitInt.        Expr7 ::= Integer ;

ELitTrue.       Expr7 ::= "true" ;

ELitFalse.      Expr7 ::= "false" ;

EString.        Expr7 ::= String ;

EApp.           Expr7 ::= Ident "(" [Expr] ")" ;

EAtom.          Expr6 ::= Expr7 ;

EIndex.         Expr6 ::= Expr6 "[" Expr "]" ;

EMethod.        Expr6 ::= Expr6 "." Ident "(" [Expr] ")" ;

EField.         Expr6 ::= Expr6 "." Ident ;

Neg.            Expr5 ::= "-" Expr6 ;

Not.            Expr5 ::= "!" Expr6 ;

EMul.           Expr4 ::= Expr4 MulOp Expr5 ;

EAdd.           Expr3 ::= Expr3 AddOp Expr4 ;

ERel.           Expr2 ::= Expr2 RelOp Expr3 ;

EAnd.           Expr1 ::= Expr2 "&&" Expr1 ;

EOr.            Expr ::= Expr1 "||" Expr ;

coercions       Expr 7 ;

separator       Expr "," ;

-- operators

Plus.   AddOp ::= "+" ;

Minus.  AddOp ::= "-" ;

Times.  MulOp ::= "*" ;

Div.    MulOp ::= "/" ;

Mod.    MulOp ::= "%" ;

LTH.    RelOp ::= "<" ;

LE.     RelOp ::= "<=" ;

GTH.    RelOp ::= ">" ;

GE.     RelOp ::= ">=" ;

EQU.    RelOp ::= "==" ;

NE.     RelOp ::= "!=" ;

-- comments

comment "#" ;

comment "//" ;

comment "/*" "*/" ;
